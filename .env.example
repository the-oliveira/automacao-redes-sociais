# Copie para .env e preencha. NUNCA commite o .env.
NIKKI_ENV=prod
NIKKI_HOST=127.0.0.1
NIKKI_PORT=8710
NIKKI_TIMEZONE=America/Sao_Paulo
# Opcional: exige header X-API-Key no POST /api/promotions
NIKKI_API_KEY=
# Opcional: URL pública (túnel/domínio) deste servidor; habilita links /go/<rede> nas legendas
NIKKI_PUBLIC_BASE_URL=

# Grupo ativo do Instagram: primary | reserve
NIKKI_INSTAGRAM_ACTIVE_GROUP=primary

# Publisher: direct (APIs oficiais das redes) | metricool (exige plano com API) | dry_run
NIKKI_PUBLISHER=direct
# Redes ativas (remova as que ainda não foram autorizadas)
NIKKI_NETWORKS=instagram,facebook,tiktok,youtube

# Meta: publica SOMENTE na Página da Nikki (nunca no perfil pessoal)
NIKKI_META_APP_ID=
NIKKI_META_APP_SECRET=
NIKKI_META_PAGE_ID=
NIKKI_META_REDIRECT_URI=http://localhost:8710/oauth/meta/callback

# Google/YouTube: publica SOMENTE no canal da Nikki
NIKKI_GOOGLE_CLIENT_ID=
NIKKI_GOOGLE_CLIENT_SECRET=
NIKKI_YOUTUBE_CHANNEL_ID=
NIKKI_YOUTUBE_PRIVACY=public

# TikTok (Login Kit Desktop + Content Posting API)
NIKKI_TIKTOK_CLIENT_KEY=
NIKKI_TIKTOK_CLIENT_SECRET=
NIKKI_TIKTOK_REDIRECT_URI=http://127.0.0.1:8710/oauth/tiktok/callback/

# Metricool (opcional, só se o plano tiver API)
NIKKI_METRICOOL_USER_TOKEN=
NIKKI_METRICOOL_USER_ID=
NIKKI_METRICOOL_BLOG_ID=
# Marca as legendas como teste da operação (desligue depois do QA)
NIKKI_QA_MODE=false

# Renderer: auto (Canva se autorizado, senão local) | canva | local
NIKKI_RENDERER=auto
NIKKI_CANVA_CLIENT_ID=
NIKKI_CANVA_CLIENT_SECRET=
NIKKI_CANVA_REDIRECT_URI=http://127.0.0.1:8710/oauth/canva/callback
NIKKI_CANVA_TEMPLATE_FEED=
NIKKI_CANVA_TEMPLATE_STORY=

# TikTok: incluir URL do grupo na legenda (padrão: não; usa "link no perfil")
NIKKI_TIKTOK_URL_IN_CAPTION=false
